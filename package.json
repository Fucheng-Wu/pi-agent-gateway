{
  "name": "pi-agent-gateway",
  "description": "An embeddable backend and web console for Pi Coding Agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fucheng-Wu/pi-agent-gateway.git"
  },
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"pnpm --filter ./backend dev\" \"pnpm --filter ./frontend dev\"",
    "build": "pnpm --filter ./backend build && pnpm --filter ./frontend build",
    "typecheck": "pnpm --filter ./backend typecheck && pnpm --filter ./frontend typecheck",
    "test:frontend": "pnpm --filter ./backend exec tsx --tsconfig ../frontend/tsconfig.json --test ../frontend/test/*.test.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
